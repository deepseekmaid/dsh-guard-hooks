{
  "name": "dsh-guard-hooks",
  "description": "Claude Code-style user-configurable hooks for DeepSeek Harness (DSH): PreToolUse interception, format-on-save, desktop notifications, audit log, webhook push",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "hooks",
    "plugin"
  ],
  "files": [
    "lib",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "picomatch": "^4.0.2"
  }
}
